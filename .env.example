# Core local setup
DATABASE_URL=mysql://root:root@localhost:3306/apf
JWT_SECRET=local-dev-secret
# Comma-separated browser origins for CORS (required in production; defaults to localhost dev ports)
# CORS_ORIGINS=http://localhost:3000,http://localhost:3100
SHADOWCAST_BASE_URL=http://localhost:8000
INTERNAL_SERVICE_SECRET=change-me-local-secret

# APF local workflow options
APF_REFRESH_REVIEW_RUNS=3
APF_USER_ID=1

# Digistore24 local collection
DIGISTORE24_AUTO_PROMOTE=true
DIGISTORE24_CONFIRM_PROMOTE=false
DIGISTORE24_REFRESH_LIMIT=50
DIGISTORE24_LOGIN_WAIT_SECONDS=600
# Backward-compatible alias used by older scripts:
DIGISTORE24_REFRESH_WAIT_SECONDS=600
DIGISTORE24_BROWSER=firefox
DIGISTORE24_ID=UnlovedProducts
DIGISTORE24_DAEMON_PORT=3219
# Optional: Playwright Firefox binary cache (avoids sandbox /tmp missing browsers)
# PLAYWRIGHT_BROWSERS_PATH=/home/YOU/.cache/ms-playwright
# Optional: persistent profiles (defaults used by scripts if unset)
# DIGISTORE24_BROWSER_PROFILE=/home/YOU/.config/unloved-digistore24-firefox-profile
# Synthetic promolink builder (importer / backfill); live Promote still preferred
# DIGISTORE24_PROMOLINK_BASE_URL=https://www.checkout-ds24.com/redir
# DIGISTORE24_CAMPAIGN_PREFIX=apf

# Review enrichment (optional but recommended)
# SearXNG must listen on host port 8088 only (docker: 8088:8080 in ~/searxng).
# After engine CAPTCHA/rate-limits: `cd ~/searxng && docker restart unloved-searxng` then wait.
# If SearXNG stays empty, set REVIEW_ENRICHMENT_PROVIDER=brave and BRAVE_SEARCH_API_KEY.
REVIEW_ENRICHMENT_ENABLED=true
REVIEW_ENRICHMENT_PROVIDER=searxng
REVIEW_ENRICHMENT_MAX_SOURCES=25
REVIEW_ENRICHMENT_REFRESH_DAYS=14
REVIEW_ENRICHMENT_SEARCH_DELAY_MS=1500
REVIEW_ENRICHMENT_SEARCH_MAX_RETRIES=2
REVIEW_ENRICHMENT_MAX_QUERIES=8
REVIEW_ENRICHMENT_MAX_VENDOR_QUERIES=4
REVIEW_ENRICHMENT_MAX_COMPETITOR_QUERIES=2
# BRAVE_SEARCH_API_KEY=
# Optional YouTube transcripts via TranscriptAPI (otherwise timedtext fallback):
# TRANSCRIPT_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
SEARXNG_BASE_URL=http://localhost:8088
